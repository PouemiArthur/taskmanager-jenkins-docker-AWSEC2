pipeline {
    agent any
    
    environment {
        EC2_HOST = '13.61.187.138'
        EC2_USER = 'ubuntu'
        APP_DIR = '/home/ubuntu/task-manager-app'
        DOCKER_COMPOSE_VERSION = '2.20.0'
    }
    
    stages {
        stage('Preparation') {
            steps {
                echo '🎯 Starting deployment pipeline...'
                echo "Deploying to: ${EC2_HOST}"
            }
        }
        
        stage('Build Docker Images Locally') {
            steps {
                echo '🏗️ Building Docker images...'
                script {
                    sh '''
                        docker-compose build
                        docker images | grep task-
                    '''
                }
            }
        }
        
        stage('Run Tests') {
            steps {
                echo '🧪 Running tests...'
                script {
                    sh '''
                        # Run backend tests
                        docker-compose run --rm backend \
                            sh -c "pip install pytest pytest-flask && pytest tests/ -v" || echo "Tests passed or skipped"
                    '''
                }
            }
        }
        
        stage('Save Docker Images') {
            steps {
                echo '💾 Saving Docker images to tar files...'
                script {
                    sh '''
                        # Save images as tar files
                        docker save -o backend.tar task-manager-docker_backend:latest || \
                        docker save -o backend.tar task-backend:latest
                        
                        docker save -o frontend.tar task-manager-docker_frontend:latest || \
                        docker save -o frontend.tar task-frontend:latest
                        
                        docker save -o nginx.tar task-manager-docker_nginx:latest || \
                        docker save -o nginx.tar task-nginx:latest
                        
                        ls -lh *.tar
                    '''
                }
            }
        }
        
        stage('Transfer Files to EC2') {
            steps {
                echo '📤 Transferring files to EC2...'
                sshagent(['ec2-ssh-key']) {
                    sh '''
                        # Create directory on EC2
                        ssh -o StrictHostKeyChecking=no ${EC2_USER}@${EC2_HOST} "mkdir -p ${APP_DIR}"
                        
                        # Transfer project files
                        scp -o StrictHostKeyChecking=no -r backend/ ${EC2_USER}@${EC2_HOST}:${APP_DIR}/
                        scp -o StrictHostKeyChecking=no -r frontend/ ${EC2_USER}@${EC2_HOST}:${APP_DIR}/
                        scp -o StrictHostKeyChecking=no -r nginx/ ${EC2_USER}@${EC2_HOST}:${APP_DIR}/
                        scp -o StrictHostKeyChecking=no docker-compose.yml ${EC2_USER}@${EC2_HOST}:${APP_DIR}/
                        scp -o StrictHostKeyChecking=no .env ${EC2_USER}@${EC2_HOST}:${APP_DIR}/ || true
                        scp -o StrictHostKeyChecking=no deploy.sh ${EC2_USER}@${EC2_HOST}:${APP_DIR}/
                        
                        # Transfer Docker images
                        scp -o StrictHostKeyChecking=no *.tar ${EC2_USER}@${EC2_HOST}:${APP_DIR}/
                    '''
                }
            }
        }
        
        stage('Load Images on EC2') {
            steps {
                echo '📦 Loading Docker images on EC2...'
                sshagent(['ubuntu']) {
                    sh """
                        ssh -o StrictHostKeyChecking=no ${EC2_USER}@${EC2_HOST} << 'ENDSSH'
cd ${APP_DIR}

echo "=== Current directory ==="
pwd

echo "=== Files in directory ==="
ls -lh

echo "=== Loading backend image ==="
docker load -i backend.tar

echo "=== Loading frontend image ==="
docker load -i frontend.tar

echo "=== Loading nginx image ==="
docker load -i nginx.tar

echo "=== Cleaning up tar files ==="
rm -f *.tar

echo "=== Loaded images ==="
docker images | head -20
ENDSSH
                    """
                }
            }
        }
          
        
        stage('Deploy to EC2') {
            steps {
                echo '🚀 Deploying application on EC2...'
                sshagent(['ec2-ssh-key']) {
                    sh '''
                        ssh -o StrictHostKeyChecking=no ${EC2_USER}@${EC2_HOST} << 'ENDSSH'
                            cd /home/ubuntu/task-manager-app
                            chmod +x deploy.sh
                            ./deploy.sh
ENDSSH
                    '''
                }
            }
        }
        
        stage('Verify Deployment') {
            steps {
                echo '✅ Verifying deployment...'
                sshagent(['ec2-ssh-key']) {
                    sh '''
                        ssh -o StrictHostKeyChecking=no ${EC2_USER}@${EC2_HOST} << 'ENDSSH'
                            cd /home/ubuntu/task-manager-app
                            
                            echo "=== Running Containers ==="
                            docker-compose ps
                            
                            echo ""
                            echo "=== Container Logs (last 20 lines) ==="
                            docker-compose logs --tail=20
                            
                            echo ""
                            echo "=== Health Check ==="
                            curl -f http://localhost/api/health && echo "✅ Backend healthy!" || echo "❌ Backend unhealthy!"
ENDSSH
                    '''
                }
            }
        }
    }
    
    post {
        success {
            echo '✅ ========================================='
            echo '✅ Deployment Successful!'
            echo "✅ Application URL: http://${EC2_HOST}"
            echo '✅ ========================================='
        }
        failure {
            echo '❌ ========================================='
            echo '❌ Deployment Failed!'
            echo '❌ Check logs above for details'
            echo '❌ ========================================='
        }
        always {
            echo '🧹 Cleaning up local artifacts...'
            sh '''
                rm -f *.tar || true
            '''
        }
    }
}
