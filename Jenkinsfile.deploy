pipeline {
    agent any
    
    environment {
        EC2_HOST = '13.61.187.138'
        EC2_USER = 'ubuntu'
        APP_DIR = '/home/ubuntu/task-manager-app'
    }
    
    stages {
        stage('Transfer Files') {
            steps {
                echo '📤 Transferring files to EC2...'
                sshagent(['ubuntu']) {
                    sh '''
                        ssh -o StrictHostKeyChecking=no ${EC2_USER}@${EC2_HOST} "mkdir -p ${APP_DIR}"
                        
                        scp -r backend/ ${EC2_USER}@${EC2_HOST}:${APP_DIR}/
                        scp -r frontend/ ${EC2_USER}@${EC2_HOST}:${APP_DIR}/
                        scp -r nginx/ ${EC2_USER}@${EC2_HOST}:${APP_DIR}/
                        scp docker-compose.yml ${EC2_USER}@${EC2_HOST}:${APP_DIR}/
                    '''
                }
            }
        }
        
        stage('Deploy') {
            steps {
                echo '🚀 Deploying on EC2...'
                sshagent(['ubuntu']) {
                    sh '''
                        ssh -o StrictHostKeyChecking=no ${EC2_USER}@${EC2_HOST} "cd ${APP_DIR} && docker-compose down && docker-compose up --build"
                    '''
                }
            }
        }
        
        stage('Check') {
            steps {
                echo '✅ Checking deployment...'
                sshagent(['ubuntu']) {
                    sh '''
                        ssh -o StrictHostKeyChecking=no ${EC2_USER}@${EC2_HOST} "docker ps"
                    '''
                }
            }
        }
    }
    
    post {
        success {
            echo "✅ SUCCESS! Visit: http://${EC2_HOST}"
        }
        failure {
            echo "❌ FAILED"
        }
    }
}
